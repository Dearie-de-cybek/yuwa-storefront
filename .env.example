# Public: leave empty so the frontend calls /api/* on this same Next.js app.
NEXT_PUBLIC_API_URL=

# PostgreSQL connection string used by Prisma.
# On Railway: add a Postgres plugin, then set this to ${{Postgres.DATABASE_URL}}
# so the app uses Railway's managed database instead of a local one.
DATABASE_URL=

# Secret used to sign auth JWTs.
JWT_SECRET=change-me

# Resend transactional email (order confirmations / status updates).
RESEND_API_KEY=
RESEND_FROM_EMAIL=YUWA <orders@yuwa.com>

# Cloudinary — media (product photos/videos) upload storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
